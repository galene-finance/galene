# Env for the public demo container. Copy ideas into the Quadlet Environment=
# lines — do NOT commit real secrets. Demo must not carry Plaid/SMTP/bank creds.

GALENE_DEMO=1
GALENE_COOKIE_SECURE=1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host

# Explicitly leave unset on demo:
# PLAID_* / SIMPLEFIN_* / SMTP_* / GALENE_OIDC_* / GALENE_API_TOKEN / GALENE_ENABLE_MCP
